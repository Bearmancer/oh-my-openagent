{
  // The Sisyphus Labs account (moved 2026-10-09, sisyphuslabs/common-infra docs/cutover-workers.md).
  // get.omo.dev is a CUSTOM DOMAIN on the Sisyphus Labs omo.dev zone: oh-my-openagent-web fetches
  // get.omo.dev/stats/downloads, and a Worker can reach another Worker on the same zone through a custom
  // domain but not through a route. /stable/* and /beta/* are omo-desktop-releases' zone routes.
  // The cron stays off until the Sisyphus Labs ANALYTICS_TOKEN secret is set (the hourly rollup needs it).
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "omo-get",
  "main": "src/index.ts",
  "account_id": "6511ce566bfe27228f536a8fb9448be5",
  "compatibility_date": "2026-09-20",
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "get.omo.dev", "zone_id": "659a56dc53ddc7f388cd59888ccedaf0", "custom_domain": true }],
  "rules": [{ "type": "Text", "globs": ["**/*.sh", "**/*.ps1"], "fallthrough": false }],
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "omo-releases" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "omo-get",
      "database_id": "755b541b-49f2-47f2-a266-465dd1860d76",
      "migrations_dir": "migrations"
    }
  ],
  "analytics_engine_datasets": [{ "binding": "DOWNLOADS", "dataset": "omo_downloads" }],
  // ANALYTICS_TOKEN (secret) is a read-only Account Analytics token used only by the hourly rollup.
  "vars": { "ACCOUNT_ID": "6511ce566bfe27228f536a8fb9448be5", "ANALYTICS_DATASET": "omo_downloads" },
  "triggers": { "crons": [] },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
