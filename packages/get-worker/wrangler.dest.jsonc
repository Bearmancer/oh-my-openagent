{
  // omo-get on the Sisyphus Labs account (account move, stage 1; plan: sisyphuslabs/common-infra
  // docs/cutover-workers.md). workers.dev only and NO cron: the personal-account Worker stays the only
  // writer until the window. Used only by .github/workflows/cutover-target-deploy.yml; wrangler.jsonc
  // (the live deploy) is unchanged.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "omo-get",
  "main": "src/index.ts",
  "account_id": "6511ce566bfe27228f536a8fb9448be5",
  "compatibility_date": "2026-09-20",
  "workers_dev": true,
  "preview_urls": false,
  "rules": [{ "type": "Text", "globs": ["**/*.sh", "**/*.ps1"], "fallthrough": false }],
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "omo-releases" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "omo-get",
      "database_id": "755b541b-49f2-47f2-a266-465dd1860d76",
      "migrations_dir": "migrations"
    }
  ],
  "analytics_engine_datasets": [{ "binding": "DOWNLOADS", "dataset": "omo_downloads" }],
  "vars": { "ACCOUNT_ID": "6511ce566bfe27228f536a8fb9448be5", "ANALYTICS_DATASET": "omo_downloads" },
  "triggers": { "crons": [] },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
